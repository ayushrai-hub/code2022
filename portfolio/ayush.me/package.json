{
  "name": "portfolio-ayush-me",
  "version": "1.0.0",
  "description": "Portfolio website for Ayush",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
